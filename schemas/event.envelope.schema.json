{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.envelope.schema.json",
  "title": "ProtocolBusEventEnvelope",
  "type": "object",
  "required": [
    "event_id",
    "topic",
    "timestamp",
    "producer",
    "correlation_id",
    "payload_ref",
    "schema",
    "priority"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "payload_ref": {
      "type": "string",
      "pattern": "^registry://"
    },
    "schema": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "description": "Event-envelope priority. NORMAL and HIGH are the canonical values written by this transport. The four lowercase values are the Protocol Bus /send vocabulary and are accepted additively (UPG-22) so an envelope carrying a bus-vocabulary priority is not rejected; see docs/PROTOCOL_ENVELOPES.md for the mapping. Nothing routes on priority today.",
      "enum": [
        "NORMAL",
        "HIGH",
        "low",
        "normal",
        "high",
        "critical"
      ]
    }
  },
  "additionalProperties": false
}