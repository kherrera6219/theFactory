# =============================================================================
# theFactory — Enterprise Hardened Configuration Template (.env.enterprise.example)
#
# Meets: ISO/IEC 25010, NIST SP 800-218 (SSDF), and OWASP Top 10 for LLMs
# Identity Provider: Strict OIDC (Keycloak / Okta / Azure AD / Entra ID)
# Transport Security: Inter-Service Mutual TLS (mTLS) Mesh
# =============================================================================

# --- Environment & Egress Control ---
ENVIRONMENT=production
PROMPT_GUARD_MODE=block
PROMPT_GUARD_BLOCK_LEVEL=high

# --- Enterprise Identity & Access Management (Zero-Trust OIDC) ---
AUTH_MODE=oidc
OIDC_ISSUER_URL=https://sso.enterprise.corp/realms/thefactory
OIDC_AUDIENCE=thefactory-api
OIDC_JWKS_URL=https://sso.enterprise.corp/realms/thefactory/protocol/openid-connect/certs
OIDC_REQUIRED_ROLE=mutate
OIDC_OPERATOR_ROLE=observe
OIDC_ENFORCE_OPERATOR_ROUTES=true
GATEWAY_ADMIN_BYPASS=false

# RFC 7519 & NIST SP 800-218 Strict Claim Enforcements
OIDC_STRICT_CLAIMS=true
OIDC_ROLE_CLAIMS=roles,groups,realm_access.roles,permissions
OIDC_SCOPE_CLAIMS=scope,scp

# Multi-Tenant Isolation (Validates against 'tenant_id' or 'tid' claim)
OIDC_REQUIRED_TENANT=enterprise-tenant-core

# --- Mutual TLS (mTLS) Inter-Service Mesh ---
INTERNAL_MTLS_ENABLED=true
INTERNAL_MTLS_CA_CERT=/run/secrets/thefactory-ca.crt
INTERNAL_MTLS_CLIENT_CERT=/run/secrets/api-gateway-client.crt
INTERNAL_MTLS_CLIENT_KEY=/run/secrets/api-gateway-client.key

# --- Internal Microservice Keys ---
INTERNAL_SERVICE_API_KEY=change-in-production-secure-32char-min
ORCHESTRATOR_INTERNAL_API_KEY=change-in-production-secure-32char-min
PROTOCOL_BUS_TOKEN=change-in-production-secure-32char-min

# --- Infrastructure Endpoints (TLS Enabled) ---
REDIS_URL=rediss://default:enterprise-redis-pwd@redis:6379/0?ssl_cert_reqs=required
DATABASE_URL=postgresql://thefactory:enterprise-pg-pwd@pgbouncer:6432/thefactory?sslmode=verify-full&sslrootcert=/run/secrets/thefactory-ca.crt
OBJECT_STORE_ENDPOINT=http://object-store:8333
QDRANT_URL=http://qdrant:6333

# --- Sandbox Security Hardening ---
SANDBOX_SECURITY_MODE=strict
SANDBOX_USER_ID=65534:65534
SANDBOX_PIDS_LIMIT=256
SANDBOX_NETWORK=none
SANDBOX_TIMEOUT_SECONDS=60
