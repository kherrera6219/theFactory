{
  "name": "mission-control",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "tokens:sync": "node scripts/sync-design-tokens.mjs",
    "dev": "npm run tokens:sync && next dev -p 3000",
    "build": "npm run tokens:sync && next build",
    "start": "next start -p 3000",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-npm-exec-clean-env.mjs playwright test",
    "test:perf": "node scripts/run-npm-exec-clean-env.mjs lhci autorun --config=./lighthouserc.json"
  },
  "overrides": {
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "tmp": "0.2.5",
    "vite": "7.3.2"
  },
  "dependencies": {
    "next": "^16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "25.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "27.0.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
