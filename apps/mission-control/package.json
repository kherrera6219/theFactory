{
  "name": "mission-control",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "tokens:sync": "node scripts/sync-design-tokens.mjs",
    "dev": "npm run tokens:sync && next dev -p 3000",
    "build": "npm run tokens:sync && next build",
    "start": "next start -p 3000",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-npm-exec-clean-env.mjs playwright test",
    "test:perf": "node scripts/run-npm-exec-clean-env.mjs lhci autorun --config=./lighthouserc.json"
  },
  "overrides": {
    "basic-ftp": "^5.3.0",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "tmp": "0.2.5",
    "vite": "8.0.8"
  },
  "dependencies": {
    "next": "^16.2.3",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "29.0.2",
    "typescript": "6.0.3",
    "vitest": "4.1.4"
  }
}
