{
  "name": "mission-control",
  "version": "0.1.0",
  "private": true,
  "main": "dist/electron/electron/main.js",
  "scripts": {
    "tokens:sync": "node scripts/sync-design-tokens.mjs",
    "dev": "npm run tokens:sync && cross-env NEXT_BUILD_TARGET=docker next dev -p 3100",
    "build": "npm run tokens:sync && cross-env NEXT_BUILD_TARGET=docker next build",
    "start": "cross-env NEXT_BUILD_TARGET=docker next start",
    "lint": "tsc --noEmit",
    "gen:api": "openapi-typescript ../../docs/openapi/api-gateway.v1.json -o app/lib/types/api.gen.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-npm-exec-clean-env.mjs playwright test",
    "test:e2e:electron": "node scripts/run-npm-exec-clean-env.mjs playwright test --config=playwright.electron.config.ts",
    "test:perf": "node scripts/run-npm-exec-clean-env.mjs lhci autorun --config=./lighthouserc.json",
    "electron:dev": "npm run tokens:sync && cross-env ELECTRON_DEV=1 tsc --project electron/tsconfig.json && electron .",
    "electron:build": "node scripts/build-electron.mjs",
    "electron:package": "npm run electron:build && electron-builder build --win --publish never",
    "postinstall": "patch-package"
  },
  "build": {
    "appId": "com.holygrail.mission-control",
    "productName": "theFactory Mission Control",
    "copyright": "Copyright © 2026 Kevin Herrera",
    "directories": {
      "output": "dist/installers"
    },
    "files": [
      "dist/electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/tray-icon-win.ico",
      "signtoolOptions": {
        "publisherName": "Kevin Herrera"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "theFactory Mission Control",
      "uninstallDisplayName": "theFactory Mission Control",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true,
      "installerIcon": "public/tray-icon-win.ico",
      "uninstallerIcon": "public/tray-icon-win.ico",
      "artifactName": "theFactory-MissionControl-Setup-${version}.${ext}"
    }
  },
  "overrides": {
    "basic-ftp": "6.0.1",
    "ip-address": "10.2.0",
    "js-yaml": "4.2.0",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "postcss": "8.5.14",
    "tar": "^7.5.11",
    "tmp": "0.2.7",
    "uuid": "^11.1.1",
    "vite": "8.0.16",
    "undici": "7.28.0"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-syntax-highlighter": "^16.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.0",
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "cross-env": "^7.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "jsdom": "29.1.1",
    "openapi-typescript": "^7.13.0",
    "patch-package": "^8.0.1",
    "ts-node": "^10.9.2",
    "typescript": "6.0.2",
    "vitest": "4.1.8"
  }
}
