NEXT_PUBLIC_API_BASE_URL=http://localhost:8100
ORCHESTRATOR_INTERNAL_BASE_URL=http://localhost:8101
INTERNAL_SERVICE_API_KEY=CHANGE_ME_match_orchestrator_internal_key
APPROVAL_HMAC_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
APPROVAL_TTL_SECONDS=86400
MISSION_CONTROL_ADMIN_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
MISSION_CONTROL_SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
MISSION_CONTROL_SESSION_TTL_SECONDS=28800
MISSION_CONTROL_SESSION_SECURE=false
# Optional: break-glass header auth for scripted /api/vault access. Generate with: openssl rand -hex 32
VAULT_ADMIN_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
# Optional: override the local encrypted vault file path (default: ~/.thefactory/vault.json)
# VAULT_DATA_PATH=/path/to/vault.json
