    subgraph PodD["Pod D — Mathematical"]
        D_Mgr["AGENT-30-PODD-MGR"]
        D_Aud["AGENT-31-PODD-AUDIT"]
        D_Matlab["AGENT-32-MATLAB"]
        D_R["AGENT-33-R"]
        D_Julia["AGENT-34-JULIA"]
