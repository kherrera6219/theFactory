  "bug_found_and_fixed": {
    "summary": "generate_pod_audit_verdict lower-cased pod_name before matching mixed-case _POD_AUDIT_AGENTS keys (podA/podB/podC/podD), so the lookup never matched for ANY pod and silently fell back to AGENT-13-PODA-AUDIT for every mission -- masked for Pod A only because the default happens to equal Pod A own audit agent.",
    "discovered_by": "This live 20-mission chat-driven battery (agent_check field per mission below)",
    "impact": "Every non-Pod-A mission (15 of 19 language missions) emitted its PBLA-01 Delta message with the wrong sender/audit-agent-id (AGENT-13-PODA-AUDIT instead of the pod own audit agent).",
    "fix_commit_pending": true,
    "fix_file": "services/orchestrator/orchestrator/llm_delegation/generators_artifacts.py",
    "fix_description": "Added a case-insensitive _POD_AUDIT_AGENTS_BY_LOWER lookup table; audit_agent_id resolution now matches regardless of pod_name casing.",
    "regression_test": "tests/services/test_llm_delegation_unit.py::test_generate_pod_audit_verdict_resolves_correct_agent_per_pod (4 parametrized cases, all pods, all pass post-fix)",
    "note": "The 15 mismatched missions in this evidence file were run against the PRE-FIX orchestrator image; their agent_check.match=False results ARE the live proof of the bug, not a residual failure."
  }
