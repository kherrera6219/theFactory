        {
          "expr": "100 * (sum(rate(orchestrator_optional_adapter_mirror_writes_total{adapter=\"neo4j\",status=\"error\"}[5m])) / clamp_min(sum(rate(orchestrator_optional_adapter_mirror_writes_total{adapter=\"neo4j\"}[5m])), 0.001))",
