          "refId": "A"
        },
        {
          "expr": "100 * (sum(rate(orchestrator_optional_adapter_mirror_writes_total{adapter=\"object_storage\",status=\"error\"}[5m])) / clamp_min(sum(rate(orchestrator_optional_adapter_mirror_writes_total{adapter=\"object_storage\"}[5m])), 0.001))",
          "legendFormat": "object storage error %",
          "refId": "B"
        }
      ],
      "title": "Mirror Write Error Rate (%)",
