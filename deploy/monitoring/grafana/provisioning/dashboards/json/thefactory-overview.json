          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(orchestrator_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "orchestrator p95",
          "refId": "B"
        }
      ],
