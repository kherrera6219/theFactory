# MCP_API_KEY must be set explicitly in production. If unset the service auto-generates
# a random key that changes on every restart, silently breaking all connected clients.
# Generate with: openssl rand -hex 32
MCP_API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
MCP_PORT=8090
MAX_MESSAGE_BYTES=1048576
# Per-agent HMAC message signing on the Protocol Bus. Default false for backward
# compatibility (existing clients send no X-Agent-Signature). When true, every
# /send caller must present a valid X-Agent-Signature signed with that agent's
# secret, configured per agent via AGENT_HMAC_SECRET_{SHORT_CODE} env vars
# (SHORT_CODE = agent id minus the AGENT- prefix, dashes → underscores;
# e.g. AGENT-31-PYTHON → AGENT_HMAC_SECRET_31_PYTHON). Signatures older than
# AGENT_HMAC_MAX_AGE_SECONDS are rejected as replays.
AGENT_HMAC_SIGNING_ENABLED=false
AGENT_HMAC_MAX_AGE_SECONDS=60
# Protocol Bus (protocol-bus-mcp) client config for the orchestrator and other
# producers/consumers. In-network the bus listens on :8090 (MCP_HOST_PORT=8102
# is only the host-side mapping). PROTOCOL_BUS_API_KEY is the canonical name and
# must equal MCP_API_KEY above; if unset, the orchestrator falls back to
# MCP_API_KEY automatically.
PROTOCOL_BUS_URL=http://protocol-bus-mcp:8090
PROTOCOL_BUS_API_KEY=
# Set false to disable the orchestrator's Protocol Bus consumer (Sigma lane).
PROTOCOL_BUS_CONSUMER_ENABLED=true
