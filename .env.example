IDEMPOTENCY_TTL_SECONDS=86400
MISSION_CREATE_UPSTREAM_MAX_ATTEMPTS=4
MISSION_CREATE_UPSTREAM_RETRY_DELAY_SECONDS=0.5
# Applies to mutating requests (POST/PUT/PATCH/DELETE).
API_RATE_LIMIT_PER_MINUTE=120
# Separate, larger budget for safe read-only methods. Mission Control polls
# ~13 GETs per cycle on the shared credential; against one combined budget an
# open browser tab exhausted the allowance and mission creation returned 429.
# Raising this does not weaken the write limit above -- the buckets are
# counted separately in Redis.
API_READ_RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_MODE=api_key
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_SHARED_SECRET=
OIDC_REQUIRED_ROLE=mutate
OIDC_OPERATOR_ROLE=observe
OIDC_ENFORCE_OPERATOR_ROUTES=true
OIDC_ROLE_CLAIMS=roles,role,permissions
OIDC_SCOPE_CLAIMS=scope,scp
# Never include HS256 — algorithm confusion attack risk
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_LEEWAY_SECONDS=60
# DANGER: set true only for local dev debugging - disables ALL operator route auth.
GATEWAY_ADMIN_BYPASS=false
STATE_STREAM=missions.state
MISSION_CONSUMER_GROUP=orchestrator
MISSION_CONSUMER_NAME=orchestrator-01
# Browsers treat http://localhost:PORT and http://127.0.0.1:PORT as DIFFERENT
# origins. Allowing only one makes the other fail its CORS preflight with a
# 400, which Mission Control surfaces as "Failed to fetch / Runtime is
# offline" rather than as an auth error. Port 3000 is the standalone Next.js
# server started by start_app.bat; 3100 is the containerised Mission Control.
# Add your LAN address too if you open the UI from another device, e.g.
#   ,http://192.168.1.50:3000
CORS_ALLOW_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8100
ORCHESTRATOR_INTERNAL_BASE_URL=http://orchestrator:8001
MISSION_CONTROL_ADMIN_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
MISSION_CONTROL_SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
MISSION_CONTROL_SESSION_TTL_SECONDS=28800
MISSION_CONTROL_SESSION_SECURE=false
VAULT_ADMIN_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
VAULT_ADDR=
VAULT_TOKEN=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_NAMESPACE=
VAULT_KV_MOUNT=secret
VAULT_KV_PREFIX=thefactory/mission-control
VAULT_SLOT_TTL_DAYS=90
VAULT_SLOT_ROTATION_WARNING_DAYS=14
VAULT_ENFORCE_SLOT_TTL=true
# Runtime environment: development | production
# In production, services will hard-fail at startup on critical misconfigurations
# (invalid AUTH_MODE, unset MCP_API_KEY, etc.) rather than silently falling back.
ENVIRONMENT=development
AUTO_TRANSITION_ENABLED=true
TRANSITION_STEP_SECONDS=1.0
MISSION_FLOW_V2_ENABLED=true
EVENT_DRIVEN_CONTROL_PLANE_ENABLED=false
# Phase 22/23 agent execution features are disabled by default. RQCA live
# execution requires an explicit sandbox profile with Docker access.
# Proceed with the PM's own recommended defaults instead of parking the
# mission in CLARIFYING. Defaults to TRUE, unusually for a behaviour flag,
# because the alternative is not a safe default but a broken one: measured
# across 12 consecutive real missions the ambiguity score was 0.95-1.0
# against a 0.7 gate, so 100% of missions stopped for an operator -- including
# ones that specified sort order, separator and exit codes explicitly. The PM
# prompt already requires a recommended default in every question, and the
# questions it asked stay recorded on the mission under
# metadata.pm_auto_accepted_defaults. Set false to restore the old hold.
PM_AUTO_ACCEPT_DEFAULTS_ENABLED=true
TESTDATA_AGENT_ENABLED=false
# Default on so RQCA_ENFORCEMENT_ENABLED is not decorative. With no reachable
# Docker daemon every mission records verdict=DRY_RUN, "Docker not available".
# Compose supplies SANDBOX_WORKSPACE_HOST_ROOT when the .env line is unset
# (not empty). A started_only run is ADVISORY, never PASS.
#
# The compose orchestrator service mounts /var/run/docker.sock to make this
# work. That is a real privilege grant -- socket access is equivalent to root on
# the host -- scoped as tightly as the mechanism allows: the service keeps uid
# 10001 and gains only the socket's group, and every sandbox it launches carries
# SANDBOX_SECURITY_FLAGS. Acceptable for a local dev stack; move execution to a
# dedicated sandbox service before production.
RQCA_AGENT_ENABLED=true
# Absolute HOST path of the shared sandbox workspace, bind-mounted into the
# orchestrator at /sandbox-workspace. Required whenever RQCA_AGENT_ENABLED=true
# and the orchestrator runs in a container: sandboxes are *sibling* containers,
# so the daemon resolves --volume sources on the host rather than inside the
# orchestrator. Leave this line commented so Compose can default to
# <compose-dir>/../.sandbox-workspace. An empty assignment (KEY=) overrides
# that default and the daemon mounts an empty directory.
# SANDBOX_WORKSPACE_HOST_ROOT=C:/path/to/theFactory/.sandbox-workspace
# Blocking by default since the 2026-07 hardening pass: a mission that fails
# runtime QC must not proceed to delivery. started_only / DRY_RUN / ADVISORY
# never block — only an actual FAIL does.
RQCA_ENFORCEMENT_ENABLED=true
DOCKER_BIN=docker
DEPABS_EXECUTION_ENABLED=false
# Two-pod PORT execution: source extraction then target generation.
PORT_TWO_PHASE_ENABLED=true
# Advisory by default (UPG-53): equivalence pass rates have not yet been
# measured across enough real missions to enforce on. Turning this on makes
# a failed required correctness check block delivery.
MISSION_EQUIVALENCE_ENFORCEMENT_ENABLED=false
# Blocking by default: a detected hard-coded secret must not reach delivery.
MISSION_SECURITY_COMPLIANCE_ENFORCEMENT_ENABLED=true
# Block outbound prompts containing secrets/PII. Default is log-only.
LLM_SAFETY_BLOCK_ENABLED=false
# Topology mode: condensed (default) | dedicated | full-dedicated
# condensed: shared pod workers + synthesized heartbeats (one compose profile)
# dedicated: one container per pod manager  full-dedicated: one container per language specialist
TOPOLOGY_MODE=condensed
LANGGRAPH_ENABLED=false
# Set to true to enable AST-backed extraction for Python (augments regex concept detection
# with accurate structural analysis — no false positives from comments or string literals).
# Falls back to regex automatically on syntax errors. Safe to enable; default off for staged rollout.
PYTHON_AST_EXTRACTOR_ENABLED=true
JS_AST_EXTRACTOR_ENABLED=true
JAVA_AST_EXTRACTOR_ENABLED=true
LANGGRAPH_FAIL_OPEN=true
LANGGRAPH_CHECKPOINTER=none
LANGGRAPH_THREAD_PREFIX=mission
LANGGRAPH_CHECKPOINTER_POSTGRES_URL=postgresql://postgres:CHANGE_ME_local_dev_postgres_password_32chars@postgres:5432/ulr?sslmode=verify-full&sslrootcert=deploy/.local/postgres-certs/ca.crt
LANGGRAPH_CHECKPOINTER_SETUP=false
LANGGRAPH_CHECKPOINT_NAMESPACE=
ORCHESTRATOR_ADMIN_API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ORCHESTRATOR_READONLY_API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
