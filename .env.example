# Behavioural equivalence: execute the generated artifact against its
# equivalence vectors in the shared hardened Docker sandbox and attach a
# behavioural section to the equivalence report. Python only; other
# languages record an honest "skipped". Requires a reachable Docker daemon
# (without one it records "skipped", never "passed"). Advisory regardless
# of MISSION_EQUIVALENCE_ENFORCEMENT_ENABLED.
MISSION_EQUIVALENCE_PYTHON_EXECUTION_ENABLED=false
RQCA_TEST_COMMAND_TEMPLATE=
# Deprecated compatibility knob; Gemini 3.5 uses GEMINI_THINKING_LEVEL.
GEMINI_THINKING_BUDGET=
# Reserved per-agent provider keys for the 41-agent registry.
# Leave empty locally unless testing provider integration.
ANTHROPIC_API_KEY_ARCH=
ANTHROPIC_API_KEY_PY=
ANTHROPIC_API_KEY_JS=
ANTHROPIC_API_KEY_TS=
ANTHROPIC_API_KEY_GO=
ANTHROPIC_API_KEY_RUST=
