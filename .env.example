# ─── Phase 2 security hardening ─────────────────────────────────────────────
# HMAC secret for tamper-evident review approval records (32+ char hex)
APPROVAL_HMAC_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
# Review approval TTL in seconds (default 24h = 86400)
APPROVAL_TTL_SECONDS=86400
# PII guard: set to "reject" to block requests with detected PII, "redact" to sanitise
PII_GUARD_MODE=redact
# Prompt injection guard: set to "block" to reject suspicious prompts, "log" to only log
PROMPT_GUARD_MODE=log
