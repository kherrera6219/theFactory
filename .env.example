# Core service URLs
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
POSTGRES_URL=postgresql://postgres:postgres@postgres:5432/ulr
ORCHESTRATOR_URL=http://orchestrator:8001
API_GATEWAY_PORT=8000
ORCHESTRATOR_PORT=8001
DASHBOARD_PORT=8080
REDIS_HOST_PORT=6380
QDRANT_HOST_PORT=6334
POSTGRES_HOST_PORT=5433
API_GATEWAY_HOST_PORT=8100
ORCHESTRATOR_HOST_PORT=8101
DASHBOARD_HOST_PORT=8180
MISSION_CONTROL_HOST_PORT=3100
INTAKE_STREAM=missions.intake
INTAKE_TOPIC=intake.feature_contract.created
MAX_STREAM_LEN=20000
IDEMPOTENCY_TTL_SECONDS=86400
API_RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_WINDOW_SECONDS=60
STATE_STREAM=missions.state
MISSION_CONSUMER_GROUP=orchestrator
MISSION_CONSUMER_NAME=orchestrator-01
CORS_ALLOW_ORIGINS=http://localhost:3100
NEXT_PUBLIC_API_BASE_URL=http://localhost:8100
AUTO_TRANSITION_ENABLED=true
TRANSITION_STEP_SECONDS=1.0
ORCHESTRATOR_ADMIN_API_KEY=admin-key
ORCHESTRATOR_READONLY_API_KEY=viewer-key
ORCHESTRATOR_API_KEYS=operator-key=mutate,read
INTERNAL_SERVICE_API_KEY=worker-key
POD_WORKER_GROUP=pod-workers
AUDIT_WORKER_GROUP=audit-workers
