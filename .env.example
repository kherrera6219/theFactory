# Core service URLs
# TLS cert paths differ between contexts:
#   Inside Docker (docker-compose): certs are mounted at /run/redis-certs/ca.crt and /run/postgres-certs/ca.crt
#   Local dev outside Docker: paths are relative to the repo root (deploy/.local/...)
#   Running make tls-certs generates certs into deploy/.local/redis-certs/ and deploy/.local/postgres-certs/
# Core service URLs
# TLS cert paths differ between contexts:
#   Inside Docker (docker-compose): certs are mounted at /run/redis-certs/ca.crt and /run/postgres-certs/ca.crt
#   Local dev outside Docker: paths are relative to the repo root (deploy/.local/...)
#   Running make tls-certs generates certs into deploy/.local/redis-certs/ and deploy/.local/postgres-certs/
REDIS_URL=rediss://:CHANGE_ME_local_dev_redis_password_32chars@redis:6380/0?ssl_cert_reqs=required&ssl_ca_certs=deploy/.local/redis-certs/ca.crt
REDIS_PASSWORD=CHANGE_ME_local_dev_redis_password_32chars
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_ENABLED=true
QDRANT_COLLECTION=mission_knowledge
QDRANT_VECTOR_SIZE=256
QDRANT_TIMEOUT_SECONDS=3.0
KNOWLEDGE_EMBEDDING_PROVIDER=gemini
KNOWLEDGE_EMBEDDING_MODEL=gemini-embedding-001
KNOWLEDGE_EMBEDDING_API_KEY=
KNOWLEDGE_EMBEDDING_TIMEOUT_SECONDS=10.0
KNOWLEDGE_REFRESH_ENABLED=true
KNOWLEDGE_REFRESH_INTERVAL_SECONDS=3600
NEO4J_ENABLED=true
NEO4J_URL=http://neo4j:7474
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME_local_dev_neo4j_password
NEO4J_DATABASE=neo4j
NEO4J_TIMEOUT_SECONDS=3.0
OBJECT_STORAGE_ENABLED=true
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin123
OBJECT_STORAGE_BUCKET=mission-audit-artifacts
OBJECT_STORAGE_PREFIX=missions
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_TIMEOUT_SECONDS=5.0
OBJECT_STORAGE_RETENTION_DAYS=90
OBJECT_STORAGE_SIZE_THRESHOLD_BYTES=524288
OBJECT_STORAGE_LEGAL_HOLD_ON_FAIL=true
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_REQUIRE_TLS=false
# Note: inside Docker the postgres sslrootcert is overridden to /run/postgres-certs/ca.crt via docker-compose env and volume mount.
POSTGRES_URL=postgresql://postgres:CHANGE_ME_local_dev_postgres_password_32chars@postgres:5432/ulr?sslmode=verify-full&sslrootcert=deploy/.local/postgres-certs/ca.crt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_local_dev_postgres_password_32chars
POSTGRES_DB=ulr
# PgBouncer sidecar (transaction pooling). In Docker the orchestrator's
# POSTGRES_URL points at pgbouncer:${PGBOUNCER_PORT}; PgBouncer holds the
# verify-full TLS connection to the real Postgres.
# Schema migrations take a session-level advisory lock and so must bypass the
# bouncer (transaction pooling drops session locks between statements). Point
# MIGRATION_POSTGRES_URL at Postgres directly; it defaults to POSTGRES_URL when
# unset (correct for non-pooled deployments). In Docker the orchestrator service
# sets this to postgres:5432 over verify-full TLS via docker-compose.
MIGRATION_POSTGRES_URL=postgresql://postgres:CHANGE_ME_local_dev_postgres_password_32chars@postgres:5432/ulr?sslmode=verify-full&sslrootcert=deploy/.local/postgres-certs/ca.crt
PGBOUNCER_PORT=5432
# Host-published bouncer port (loopback only). Defaults to 5432; override if the
# host already binds 5432 (the direct Postgres port is published as 5433).
PGBOUNCER_HOST_PORT=5432
# Retention window for append-only audit tables, enforced by prune_audit_tables().
AUDIT_RETENTION_DAYS=90
DB_NAME_KNOWLEDGE_LAKE=knowledge_lake
DB_NAME_STATE_GRAPH=state_graph
DB_NAME_LOGICNODE_REGISTRY=logicnode_registry
DB_NAME_TRACEABILITY_LEDGER=traceability_ledger
DB_NAME_MODEL_STORE=model_store
ORCHESTRATOR_URL=http://orchestrator:8001
API_GATEWAY_PORT=8000
ORCHESTRATOR_PORT=8001
DASHBOARD_PORT=8080
REDIS_HOST_PORT=6380
QDRANT_HOST_PORT=6334
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
MILVUS_ENABLED=true
MILVUS_COLLECTION=mission_knowledge
MILVUS_VECTOR_SIZE=64
MILVUS_TIMEOUT_SECONDS=3.0
NEO4J_HTTP_HOST_PORT=7474
NEO4J_BOLT_HOST_PORT=7687
POSTGRES_HOST_PORT=5433
API_GATEWAY_HOST_PORT=8100
ORCHESTRATOR_HOST_PORT=8101
DASHBOARD_HOST_PORT=8180
MISSION_CONTROL_HOST_PORT=3100
MCP_HOST_PORT=8102
# Host interface the MCP port binds to. Dev leaves this at 0.0.0.0 so the port
# is reachable from the host. Prod MUST set MCP_HOST_BIND=127.0.0.1 so the
# port is only reachable on the loopback — internal services use the Docker
# bridge network directly, no public exposure.
MCP_HOST_BIND=0.0.0.0
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MILVUS_HOST_PORT=19530
MILVUS_METRICS_HOST_PORT=9091
JAEGER_UI_HOST_PORT=16686
OTLP_GRPC_HOST_PORT=4317
OTLP_HTTP_HOST_PORT=4318
OTEL_TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://jaeger:4318/v1/traces
APP_OOM_SCORE_ADJ=-500
DATA_SERVICE_OOM_SCORE_ADJ=-850
PAGER_WEBHOOK_URL=http://host.docker.internal:9999/pager
