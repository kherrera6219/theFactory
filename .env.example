# Grafana admin credentials — REQUIRED for the monitoring stack. Never leave at admin/admin.
GRAFANA_ADMIN_USER=change-me-grafana-admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_use_a_long_random_password_32+_chars
INTAKE_STREAM=missions.intake
INTAKE_DLQ_STREAM=factory:dlq:intake-stream
INTAKE_DLQ_MAX_LEN=1000
INTAKE_TOPIC=intake.feature_contract.created
